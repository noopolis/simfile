spawnfile_version: "0.1"
kind: team
name: office-secret-v0
description: "Memetics increment (a) fixture: Eleanor and Sam negotiate the same office rollout decision as office-sim, but the room's kickoff and clock are driven live by the Simfile world, and Eleanor carries a Decision-13 doc-seeded secret (workspace.docs.memory) that her scripted reply works into the room."

shared:
  workspace:
    docs:
      system: TEAM.md

members:
  - id: eleanor
    ref: ./agents/eleanor
  - id: sam
    ref: ./agents/sam

memory:
  - id: office-recall
    access:
      members: [eleanor, sam]
    store:
      kind: json
      path: /var/lib/spawnfile/memory/office-secret-v0/office-recall.jsonl
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false

mode: swarm

networks:
  - id: office_lab
    name: Office Lab
    provider: moltnet
    server:
      mode: managed
      listen:
        bind: 0.0.0.0
        port: 19951
      store:
        kind: memory
      auth:
        mode: none
      human_ingress: true
    rooms:
      - id: office-room
        members: [eleanor, sam]

policy:
  mode: warn
  on_degrade: warn
