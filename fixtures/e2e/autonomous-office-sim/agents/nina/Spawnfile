spawnfile_version: "0.1"
kind: agent
name: nina
description: "Nina is Maya's sibling and appears in home conversations."

runtime:
  name: pi
  options:
    engine: agy

execution:
  model:
    primary:
      provider: local
      name: agy-cli
      auth:
        method: none
      endpoint:
        compatibility: openai
        base_url: http://127.0.0.1:11434/v1
  sandbox:
    mode: workspace

schedule:
  kind: every
  every: 9.5m
  prompt: "Check the clock, stay concrete, and reply where you were addressed."

memory:
  - id: self
    consolidation:
      mode: scheduled
      schedule: 43m
    store:
      kind: json
      path: /var/lib/spawnfile/memory/nina/self.jsonl
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: true
        provider: ollama
        model: nomic-embed-text
        dimensions: 768

workspace:
  docs:
    system: AGENTS.md
