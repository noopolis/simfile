spawnfile_version: "0.1"
kind: agent
name: cam
description: "Cam is Theo's roommate and appears in home conversations."

runtime:
  name: pi
  options:
    engine: codex

execution:
  model:
    primary:
      provider: local
      name: codex-cli
      auth:
        method: none
      endpoint:
        compatibility: openai
        base_url: http://127.0.0.1:11434/v1
  sandbox:
    mode: workspace

schedule:
  kind: every
  every: 7.5m
  prompt: "Check the clock, keep a practical home boundary, and reply where addressed."

memory:
  - id: self
    consolidation:
      mode: scheduled
      schedule: 35m
    store:
      kind: json
      path: /var/lib/spawnfile/memory/cam/self.jsonl
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: true
        provider: ollama
        model: nomic-embed-text
        dimensions: 768

workspace:
  docs:
    system: AGENTS.md
