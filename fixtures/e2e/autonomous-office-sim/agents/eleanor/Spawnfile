spawnfile_version: "0.1"
kind: agent
name: eleanor
description: "Eleanor is a Jungian self-like managing partner coordinating law office operations."

runtime:
  name: pi
  options:
    engine: codex

execution:
  model:
    primary:
      provider: local
      name: codex-cli
      auth:
        method: none
      endpoint:
        compatibility: openai
        base_url: http://127.0.0.1:11434/v1
  sandbox:
    mode: workspace

schedule:
  kind: every
  every: 3.5m
  prompt: "Check the clock, tend pending office work, and reply where you were addressed."

memory:
  - id: self
    consolidation:
      mode: scheduled
      schedule: 32m
    store:
      kind: json
      path: /var/lib/spawnfile/memory/eleanor/self.jsonl
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: true
        provider: ollama
        model: nomic-embed-text
        dimensions: 768

workspace:
  docs:
    system: AGENTS.md
